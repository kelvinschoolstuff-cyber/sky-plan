# Copy to .env (Docker Compose reads it). For frontend/.env only VITE_API_URL is used.
DATABASE_URL=postgresql+psycopg://agricast:agricast@localhost:5432/agricast
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Optional SMS alerts (Africa's Talking). Leave AT_API_KEY empty for a dry run.
AT_API_KEY=
AT_USERNAME=sandbox
VITE_API_URL=http://localhost:8000
# Presentations only: 1 loads SAMPLE placeholder calendar rows so the calendar screens have something to show.
# The app then shows a red DEMO MODE banner. Leave 0 for anything real.
DEMO_SAMPLE_CALENDAR=0
# The shipped KALRO/FAO calendar records load automatically on first start. Set 0 to start with an empty calendar.
AUTO_LOAD_CALENDAR=1
